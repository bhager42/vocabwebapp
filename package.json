{
	"name": "vocabwebapp",
	"version": "1.0.1",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest --run && npm run test:e2e",
		"test:e2e": "playwright install chromium && playwright test",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"start": "node server.js",
		"content:check": "node scripts/content-check.ts",
		"db:seed": "node scripts/seed.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/js": "10.0.1",
		"@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
		"@playwright/test": "1.65.0",
		"@sveltejs/adapter-node": "6.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "24.19.2",
		"drizzle-kit": "0.31.11",
		"drizzle-orm": "0.45.4",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.2",
		"vite": "8.3.7",
		"vitest": "4.1.12"
	},
	"dependencies": {
		"better-sqlite3": "13.0.3",
		"valibot": "1.5.0"
	},
	"engines": {
		"node": ">=24"
	}
}
